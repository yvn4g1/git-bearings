{
  "name": "git-bearings",
  "displayName": "Git Bearings",
  "description": "A VS Code extension that makes a repository's Git state easier to see.",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "gitBearings.open",
        "title": "Git Bearings: 開く"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "gitBearings.sidebar",
          "name": "Git Bearings",
          "when": "gitBearings.uiOpened"
        }
      ]
    }
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc --noEmit -p ./",
    "test:git-executor": "npm run compile && node --test out/git/gitExecutor.test.js",
    "test:core-reader": "npm run compile && node --test out/git/coreRepositoryReader.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.7.0"
  }
}
